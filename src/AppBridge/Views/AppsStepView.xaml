<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AppBridge.Views.AppsStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AppBridge.ViewModels"
    xmlns:views="using:AppBridge.Views">

  <UserControl.Resources>
    <!-- The search field stays a soft grey capsule when hovered or focused. -->
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#26767680" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#26767680" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
  </UserControl.Resources>

  <Grid>
    <Grid MaxWidth="680" Padding="24,4,24,8" Visibility="{x:Bind ViewModel.ShowRestoreContent, Mode=OneWay}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Style="{StaticResource LargeTitleStyle}" Text="{x:Bind ViewModel.AppsTitle, Mode=OneWay}" />
      <TextBlock Style="{StaticResource HeroSubtitleStyle}" Text="{x:Bind ViewModel.AppsSubtitle, Mode=OneWay}" />
    </StackPanel>

    <!-- Search, sorting and select all -->
    <Grid Grid.Row="1" Margin="0,22,0,12" ColumnSpacing="12" Visibility="{x:Bind ViewModel.AppList.ShowList, Mode=OneWay}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Uid="Apps_Search" Style="{StaticResource SearchBoxStyle}" PlaceholderText="Search"
               Text="{x:Bind ViewModel.AppList.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource AppSecondaryLabelBrush}"
                HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
      <Button Grid.Column="1" Style="{StaticResource SmallPillButtonStyle}" Content="{x:Bind ViewModel.AppList.SortButtonText, Mode=OneWay}"
              Command="{x:Bind ViewModel.AppList.ToggleSortModeCommand, Mode=OneWay}"
              ToolTipService.ToolTip="{x:Bind ViewModel.AppList.SortButtonText, Mode=OneWay}"
              AutomationProperties.Name="{x:Bind ViewModel.AppList.SortButtonText, Mode=OneWay}" />
      <HyperlinkButton Grid.Column="2" Content="{x:Bind ViewModel.AppList.SelectAllText, Mode=OneWay}"
                       Command="{x:Bind ViewModel.AppList.ToggleSelectAllCommand, Mode=OneWay}" FontWeight="SemiBold" />
    </Grid>

    <!-- Current-account apps missing from the Russian storefront. -->
    <Border Grid.Row="2" Style="{StaticResource GroupCardStyle}" Margin="0,0,0,12" Padding="14,10"
            Visibility="{x:Bind ViewModel.ShowStorefrontStatus, Mode=OneWay}">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ProgressRing Width="16" Height="16" VerticalAlignment="Center"
                      IsActive="{x:Bind ViewModel.Apps.IsStorefrontScanning, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.Apps.IsStorefrontScanning, Mode=OneWay}" />
        <TextBlock Grid.Column="1" Style="{StaticResource RowSubtitleStyle}" TextWrapping="Wrap" VerticalAlignment="Center"
                   Text="{x:Bind ViewModel.Apps.StorefrontStatus, Mode=OneWay}" />
        <HyperlinkButton Grid.Column="2" VerticalAlignment="Center" Padding="8,4" FontWeight="SemiBold"
                         Content="{x:Bind ViewModel.Apps.UnavailableFilterText, Mode=OneWay}"
                         Command="{x:Bind ViewModel.Apps.ToggleUnavailableFilterCommand, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.Apps.HasUnavailableApps, Mode=OneWay}" />
      </Grid>
    </Border>

    <!-- Loading -->
    <StackPanel Grid.Row="3" Visibility="{x:Bind ViewModel.AppList.IsLoading, Mode=OneWay}" VerticalAlignment="Center" Spacing="14">
      <ProgressRing IsActive="{x:Bind ViewModel.AppList.IsLoading, Mode=OneWay}" Width="32" Height="32" />
      <TextBlock Style="{StaticResource RowBodyStyle}" Foreground="{ThemeResource AppSecondaryLabelBrush}"
                 HorizontalAlignment="Center" Text="{x:Bind ViewModel.AppList.LoadingText, Mode=OneWay}" />
    </StackPanel>

    <!-- Error -->
    <StackPanel Grid.Row="3" Visibility="{x:Bind ViewModel.AppList.HasError, Mode=OneWay}" VerticalAlignment="Center" Spacing="14" Margin="0,24,0,0">
      <FontIcon Glyph="&#xE7BA;" FontSize="32" Foreground="{ThemeResource AppOrangeBrush}" />
      <TextBlock Style="{StaticResource RowBodyStyle}" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"
                 Text="{x:Bind ViewModel.AppList.Error, Mode=OneWay}" />
      <Button x:Uid="Apps_TryAgain" Style="{StaticResource SmallPillButtonStyle}" HorizontalAlignment="Center" Content="Try Again"
              Command="{x:Bind ViewModel.RetryAppsCommand}" />
    </StackPanel>

    <!-- Nothing to list -->
    <StackPanel Grid.Row="3" Visibility="{x:Bind ViewModel.AppList.ShowEmpty, Mode=OneWay}" VerticalAlignment="Center" Spacing="10" Margin="0,24,0,0">
      <FontIcon Glyph="&#xE71D;" FontSize="32" Foreground="{ThemeResource AppTertiaryLabelBrush}" />
      <TextBlock Style="{StaticResource RowBodyStyle}" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"
                 Foreground="{ThemeResource AppSecondaryLabelBrush}" Text="{x:Bind ViewModel.AppList.EmptyText, Mode=OneWay}" />
    </StackPanel>

    <!-- App list -->
    <Border Grid.Row="3" Style="{StaticResource GroupCardStyle}" Padding="0,4" Visibility="{x:Bind ViewModel.AppList.ShowList, Mode=OneWay}">
      <Grid>
        <ListView ItemsSource="{x:Bind ViewModel.AppList.Visible, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnAppClick"
                  ItemContainerStyle="{StaticResource InsetRowItemStyle}">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:AppItemViewModel">
              <StackPanel>
                <!-- "Not available on this iPhone" header above the first such app. -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="4,16,0,6" Text="{x:Bind SectionHeader}"
                           Visibility="{x:Bind ShowSectionHeader, Mode=OneWay}" />
                <Grid MinHeight="60">
                  <Rectangle Style="{StaticResource SeparatorStyle}" Margin="92,0,-12,0" Visibility="{x:Bind ShowSeparator, Mode=OneWay}" />
                  <Grid ColumnSpacing="14" Padding="0,9" Opacity="{x:Bind views:Ui.DimUnless(IsSelectable)}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="24" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Style="{StaticResource CircleCheckBoxStyle}" VerticalAlignment="Center" Visibility="{x:Bind IsSelectable}"
                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name}" />
                    <Grid Grid.Column="1" Width="40" Height="40" VerticalAlignment="Center">
                      <Border CornerRadius="{StaticResource AppIconCornerRadius}" Background="{ThemeResource AppIconPlaceholderBrush}" />
                      <TextBlock Text="{x:Bind Initial}" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource AppSecondaryLabelBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ShowInitial, Mode=OneWay}" />
                      <Border CornerRadius="{StaticResource AppIconCornerRadius}" Visibility="{x:Bind HasIcon, Mode=OneWay}">
                        <Border.Background>
                          <ImageBrush ImageSource="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border.Background>
                      </Border>
                      <Border CornerRadius="{StaticResource AppIconCornerRadius}" BorderThickness="1" BorderBrush="{ThemeResource AppCardStrokeBrush}" />
                    </Grid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource RowTitleStyle}" Text="{x:Bind Name}" />
                      <TextBlock Style="{StaticResource RowSubtitleStyle}" Text="{x:Bind Detail}" />
                      <Grid Visibility="{x:Bind HasCaption, Mode=OneWay}">
                        <TextBlock Style="{StaticResource RowSubtitleStyle}" Text="{x:Bind Caption, Mode=OneWay}"
                                   Visibility="{x:Bind views:Ui.Collapsed(CaptionIsAccent)}" />
                        <TextBlock Style="{StaticResource RowSubtitleStyle}" Text="{x:Bind Caption, Mode=OneWay}" Foreground="{ThemeResource AppBlueBrush}"
                                   Visibility="{x:Bind CaptionIsAccent}" />
                      </Grid>
                      <TextBlock Style="{StaticResource RowSubtitleStyle}" Text="{x:Bind AvailabilityText, Mode=OneWay}"
                                 Foreground="{ThemeResource AppOrangeBrush}" Visibility="{x:Bind HasAvailability, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" FontSize="12" Foreground="{ThemeResource AppSecondaryLabelBrush}"
                               VerticalAlignment="Center" />
                  </Grid>
                </Grid>
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Uid="Apps_NoMatches" Visibility="{x:Bind ViewModel.AppList.ShowNoMatches, Mode=OneWay}" Style="{StaticResource RowBodyStyle}"
                   Foreground="{ThemeResource AppSecondaryLabelBrush}" HorizontalAlignment="Center" Margin="0,28" Text="No matching apps" />
      </Grid>
    </Border>

    <TextBlock Grid.Row="4" Style="{StaticResource FootnoteStyle}" Margin="16,10,16,0" TextAlignment="Center"
               Visibility="{x:Bind ViewModel.AppList.HasFootnote, Mode=OneWay}" Text="{x:Bind ViewModel.AppList.Footnote, Mode=OneWay}"
               ToolTipService.ToolTip="{x:Bind ViewModel.AppList.FootnoteDetail, Mode=OneWay}" />
    </Grid>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                  Visibility="{x:Bind ViewModel.ShowRestoreSignIn, Mode=OneWay}">
      <StackPanel MaxWidth="560" Padding="24,0,24,32" VerticalAlignment="Center">
        <TextBlock x:Uid="Restore_SignInTitle" Style="{StaticResource LargeTitleStyle}" Text="Sign in to see your purchases" />
        <TextBlock x:Uid="Restore_SignInSubtitle" Style="{StaticResource HeroSubtitleStyle}" Margin="0,0,0,24"
                   Text="Use the Apple Account that owns your apps." />
        <views:SignInPanel Account="{x:Bind ViewModel.Account}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
