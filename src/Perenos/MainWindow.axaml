<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Perenos.ViewModels"
        xmlns:views="using:Perenos.Views"
        xmlns:s="using:Perenos.Services"
        xmlns:c="using:Perenos.Converters"
        x:Class="Perenos.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="940" Height="780" MinWidth="680" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Perenos/Assets/Perenos.ico"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        WindowDecorations="BorderOnly"
        Title="{s:Text App_Name}">
  <Window.Resources>
    <c:InverseBoolConverter x:Key="Not"/>
  </Window.Resources>
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{DynamicResource BackgroundBrush}">
    <Rectangle Grid.RowSpan="5" IsHitTestVisible="False" Fill="{DynamicResource BackgroundGlowBrush}"/>

    <Grid x:Name="TitleBar" Grid.Row="0" Height="44" Background="Transparent" PointerPressed="TitleBarPressed" DoubleTapped="TitleBarDoubleTapped">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <StackPanel x:Name="BrandPanel" Orientation="Horizontal" Spacing="10" Margin="14,0" VerticalAlignment="Center">
          <Image Source="avares://Perenos/Assets/AppIcon.png" Width="20" Height="20" VerticalAlignment="Center"/>
          <TextBlock Text="{s:Text App_Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,10,0" VerticalAlignment="Center">
          <Button Classes="quiet" Click="ShowSettings" AutomationProperties.Name="{s:Text Settings_Button}" Padding="10" MinWidth="0">
            <PathIcon Width="17" Height="17" Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
          </Button>
        </StackPanel>
        <StackPanel x:Name="CaptionButtons" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch">
          <Button Classes="caption" Click="MinimizeWindow" AutomationProperties.Name="{s:Text Window_Minimize}">
            <PathIcon Width="12" Height="12" Data="M4 11h16v1.5H4z"/>
          </Button>
          <Button Classes="caption" Click="ToggleMaximize" AutomationProperties.Name="{s:Text Window_Maximize}">
            <Grid Width="12" Height="12">
              <PathIcon x:Name="MaximizeGlyph" Width="12" Height="12" Data="M4 4h16v16H4V4Zm1.5 1.5v13h13v-13h-13Z"/>
              <PathIcon x:Name="RestoreGlyph" Width="12" Height="12" IsVisible="False" Data="M8 8h11v11H8V8Zm1.5 1.5v8h8v-8h-8ZM5 5h11v2h-1.5V6.5H6.5V15H5V5Z"/>
            </Grid>
          </Button>
          <Button Classes="caption caption-close" Click="CloseWindow" AutomationProperties.Name="{s:Text Window_Close}">
            <PathIcon Width="12" Height="12" Data="m6.4 5 5.6 5.6L17.6 5 19 6.4 13.4 12 19 17.6 17.6 19 12 13.4 6.4 19 5 17.6 10.6 12 5 6.4 6.4 5Z"/>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>

    <Grid Grid.Row="1" MaxWidth="600" Margin="24,10,24,12" HorizontalAlignment="Center" IsVisible="{Binding ShowStepProgress}">
      <StackPanel Spacing="9">
        <TextBlock Text="{Binding StepCaption}" TextAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <ProgressBar Value="{Binding StepProgress}" Maximum="100" Height="4" AutomationProperties.Name="{Binding StepCaption}"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Classes="card" MaxWidth="600" Margin="24,0,24,12" Padding="16,12" IsVisible="{Binding IsToolMissing}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <PathIcon Width="18" Height="18" Data="M12 2 1 21h22L12 2Zm0 6 7.5 13h-15L12 8Zm-1 4v4h2v-4h-2Zm0 5v2h2v-2h-2Z" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{s:Text ToolMissing}" Classes="caption" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Grid Grid.Row="3">
      <views:StartView x:Name="StartStep" IsVisible="{Binding IsStartStep}"/>
      <views:LaterView x:Name="LaterStep" IsVisible="{Binding IsLaterStep}"/>
      <views:DeviceStepView x:Name="DeviceStep" IsVisible="{Binding IsDeviceStep}"/>
      <views:AppsStepView x:Name="AppsStep" IsVisible="{Binding IsAppsStep}"/>
      <views:InstallStepView x:Name="InstallStep" IsVisible="{Binding IsInstallStep}"/>
    </Grid>

    <Grid Grid.Row="4" Margin="24,8,24,20" RowDefinitions="Auto,Auto">
      <TextBlock Text="{Binding FooterHint}" Classes="caption" HorizontalAlignment="Center" TextAlignment="Center"
                 Margin="0,0,0,10" IsVisible="{Binding HasFooterHint}"/>
      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
        <Button Classes="quiet" Command="{Binding BackCommand}" IsVisible="{Binding ShowBack}"
                AutomationProperties.Name="{Binding BackText}" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="14" Height="14" Data="m15 18-6-6 6-6 1.4 1.4L11.8 12l4.6 4.6L15 18Z"/>
            <TextBlock Text="{Binding BackText}" FontSize="14" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Classes="secondary" Content="{Binding SecondaryText}" Command="{Binding SecondaryCommand}" IsVisible="{Binding ShowSecondary}"/>
          <Button Classes="primary" Classes.danger="{Binding Install.IsRunning}" Command="{Binding PrimaryCommand}"
                  IsVisible="{Binding ShowPrimary}" IsEnabled="{Binding IsPrimaryEnabled}" AutomationProperties.Name="{Binding PrimaryText}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding PrimaryText}" VerticalAlignment="Center"/>
              <PathIcon Classes="on-accent" Width="13" Height="13" Data="m9 18 6-6-6-6-1.4 1.4 4.6 4.6-4.6 4.6L9 18Z" IsVisible="{Binding PrimaryShowsForward}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
