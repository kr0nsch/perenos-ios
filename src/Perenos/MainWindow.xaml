<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Perenos.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Perenos">

  <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Rectangle Grid.RowSpan="5" IsHitTestVisible="False" Fill="{ThemeResource BackgroundGlowBrush}" />

    <TitleBar x:Name="AppTitleBar" Title="Perenos">
      <TitleBar.IconSource>
        <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
      </TitleBar.IconSource>
      <TitleBar.RightHeader>
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,6,0" VerticalAlignment="Center">
          <Button x:Name="AccountButton" x:Uid="TitleBar_Account" Style="{StaticResource TitleBarButtonStyle}" Click="OnAccountClick"
                  IsEnabled="{x:Bind ViewModel.Account.IsIdle, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE77B;" FontSize="14" />
              <TextBlock Text="{x:Bind ViewModel.Account.TitleBarText, Mode=OneWay}" FontSize="13" MaxWidth="180"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Uid="TitleBar_Settings" Style="{StaticResource TitleBarButtonStyle}" Click="OnSettingsClick">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <FontIcon Glyph="&#xE713;" FontSize="15" />
              <TextBlock x:Uid="Settings_Button" Text="Settings" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </TitleBar.RightHeader>
    </TitleBar>

    <Grid Grid.Row="1" MaxWidth="600" Margin="24,12,24,12" HorizontalAlignment="Center"
          Visibility="{x:Bind ViewModel.ShowStepProgress, Mode=OneWay}">
      <StackPanel Spacing="9">
        <TextBlock Text="{x:Bind ViewModel.StepCaption, Mode=OneWay}" TextAlignment="Center"
                   FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AppSecondaryLabelBrush}" />
        <ProgressBar Value="{x:Bind ViewModel.StepProgress, Mode=OneWay}" Maximum="100" Height="4"
                     AutomationProperties.Name="{x:Bind ViewModel.StepCaption, Mode=OneWay}" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="2">
      <Border Style="{StaticResource GroupCardStyle}" MaxWidth="600" Margin="24,0,24,12" Padding="16,12"
              Visibility="{x:Bind ViewModel.IsToolMissing}">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="{ThemeResource AppRedBrush}" VerticalAlignment="Center" />
          <TextBlock x:Uid="ToolMissing" Grid.Column="1" Style="{StaticResource FootnoteStyle}" VerticalAlignment="Center"
                     Text="A required component (ipatool) is missing, so apps can't be downloaded. Please reinstall Perenos." />
        </Grid>
      </Border>

      <Border Style="{StaticResource GroupCardStyle}" MaxWidth="600" Margin="24,0,24,12" Padding="16,12"
              Visibility="{x:Bind ViewModel.Account.HasSignOutError, Mode=OneWay}">
        <Grid ColumnSpacing="12" RowSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="{ThemeResource AppRedBrush}" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" Style="{StaticResource FootnoteStyle}" Text="{x:Bind ViewModel.Account.Error, Mode=OneWay}"
                     AutomationProperties.LiveSetting="Assertive" />
          <HyperlinkButton x:Uid="Account_SignOutRetry" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Padding="0"
                           Content="Try Sign Out Again" Command="{x:Bind ViewModel.Account.SignOutCommand}" />
        </Grid>
      </Border>
    </StackPanel>

    <ContentControl x:Name="StepHost" Grid.Row="3" IsTabStop="False"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <ContentControl.ContentTransitions>
        <TransitionCollection>
          <ContentThemeTransition HorizontalOffset="24" VerticalOffset="0" />
        </TransitionCollection>
      </ContentControl.ContentTransitions>
    </ContentControl>

    <Grid Grid.Row="4" Padding="24,8,24,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Style="{StaticResource FootnoteStyle}" HorizontalAlignment="Center" TextAlignment="Center"
                 Text="{x:Bind ViewModel.FooterHint, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasFooterHint, Mode=OneWay}"
                 Margin="0,0,0,12" />
      <Grid Grid.Row="1">
        <Button Style="{StaticResource SmallPillButtonStyle}" Command="{x:Bind ViewModel.BackCommand}"
                AutomationProperties.Name="{x:Bind ViewModel.BackText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ShowBack, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE76B;" FontSize="13" />
            <TextBlock x:Uid="Footer_Back" Text="Back" FontSize="14" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource SecondaryPillButtonStyle}" Content="{x:Bind ViewModel.SecondaryText, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.ShowSecondary, Mode=OneWay}" Command="{x:Bind ViewModel.SecondaryCommand}" />
          <Button x:Name="PrimaryButton" Style="{StaticResource PillButtonStyle}"
                  AutomationProperties.Name="{x:Bind ViewModel.PrimaryText, Mode=OneWay}"
                  Visibility="{x:Bind ViewModel.ShowPrimary, Mode=OneWay}" Command="{x:Bind ViewModel.PrimaryCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{x:Bind ViewModel.PrimaryText, Mode=OneWay}" VerticalAlignment="Center" />
              <FontIcon Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.PrimaryShowsForward, Mode=OneWay}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
