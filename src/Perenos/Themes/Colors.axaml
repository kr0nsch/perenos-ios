<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Perenos 1.6.0 design system: Apple-inspired palette (iOS system colors), opaque grouped
    cards with hairline strokes, flat canvas with a soft radial glow. Primary buttons use the
    darker iOS accent variants so white label text keeps a 4.5:1 contrast ratio.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="AccentColor">#007AFF</Color>
      <SolidColorBrush x:Key="AccentBrush" Color="#007AFF"/>
      <SolidColorBrush x:Key="AccentTextBrush" Color="#007AFF"/>
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#0066DB"/>
      <SolidColorBrush x:Key="AccentButtonBrush" Color="#0066DB"/>
      <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#0052B0"/>
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#14007AFF"/>
      <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F5F7"/>
      <SolidColorBrush x:Key="CanvasBrush" Color="#F5F5F7"/>
      <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="CardHoverBrush" Color="#1F767680"/>
      <SolidColorBrush x:Key="GlassBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="GlassStrongBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="GlassBorderBrush" Color="#12000000"/>
      <SolidColorBrush x:Key="TextBrush" Color="#1D1D1F"/>
      <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6E6E73"/>
      <SolidColorBrush x:Key="TertiaryTextBrush" Color="#AEAEB2"/>
      <SolidColorBrush x:Key="DisabledTextBrush" Color="#56565A"/>
      <SolidColorBrush x:Key="DisabledBrush" Color="#E9E9EB"/>
      <SolidColorBrush x:Key="BorderBrush" Color="#12000000"/>
      <SolidColorBrush x:Key="SeparatorBrush" Color="#243C3C43"/>
      <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D1D6"/>
      <SolidColorBrush x:Key="SubtleBrush" Color="#1F767680"/>
      <SolidColorBrush x:Key="SuccessBrush" Color="#34C759"/>
      <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1A34C759"/>
      <SolidColorBrush x:Key="WarningBrush" Color="#FF9500"/>
      <SolidColorBrush x:Key="WarningSoftBrush" Color="#1AFF9500"/>
      <SolidColorBrush x:Key="DangerBrush" Color="#FF3B30"/>
      <SolidColorBrush x:Key="IconBrush" Color="#6E6E73"/>
      <SolidColorBrush x:Key="IconPlaceholderBrush" Color="#E5E5EA"/>
      <SolidColorBrush x:Key="OverlayBrush" Color="#190B1526"/>
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#34C759"/>
      <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#34C759"/>
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#30B852"/>
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#30B852"/>
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#2AA64A"/>
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#2AA64A"/>
      <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#D1D1D6"/>
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#007AFF"/>
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#007AFF"/>
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="RadioButtonCheckGlyphStroke" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#0066DB"/>
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#0066DB"/>
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#0052B0"/>
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#0052B0"/>
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillDisabled" Color="#E9E9EB"/>
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokeDisabled" Color="#E9E9EB"/>
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokePointerOver" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokePressed" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFillDisabled" Color="#56565A"/>
      <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokeDisabled" Color="#56565A"/>
      <LinearGradientBrush x:Key="DeviceIconBrush" StartPoint="15%,0%" EndPoint="85%,100%">
        <GradientStop Color="#0096DC" Offset="0"/>
        <GradientStop Color="#3C46E6" Offset="1"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="HeroBlueBrush" StartPoint="15%,0%" EndPoint="85%,100%">
        <GradientStop Color="#0096DC" Offset="0"/>
        <GradientStop Color="#3C46E6" Offset="1"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="HeroTealBrush" StartPoint="15%,0%" EndPoint="85%,100%">
        <GradientStop Color="#30C4C8" Offset="0"/>
        <GradientStop Color="#007AFF" Offset="1"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="HeroIndigoBrush" StartPoint="15%,0%" EndPoint="85%,100%">
        <GradientStop Color="#786EFF" Offset="0"/>
        <GradientStop Color="#583CD6" Offset="1"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="HeroGreenBrush" StartPoint="15%,0%" EndPoint="85%,100%">
        <GradientStop Color="#48D678" Offset="0"/>
        <GradientStop Color="#14A06E" Offset="1"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="HeroOrangeBrush" StartPoint="15%,0%" EndPoint="85%,100%">
        <GradientStop Color="#FFB340" Offset="0"/>
        <GradientStop Color="#FF7028" Offset="1"/>
      </LinearGradientBrush>
      <RadialGradientBrush x:Key="BackgroundGlowBrush" Center="50%,0%" GradientOrigin="50%,0%" RadiusX="0.75" RadiusY="0.6">
        <GradientStop Color="#1A007AFF" Offset="0"/>
        <GradientStop Color="#08007AFF" Offset="0.6"/>
        <GradientStop Color="#00007AFF" Offset="1"/>
      </RadialGradientBrush>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="AccentColor">#0A84FF</Color>
      <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF"/>
      <SolidColorBrush x:Key="AccentTextBrush" Color="#0A84FF"/>
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#0070DB"/>
      <SolidColorBrush x:Key="AccentButtonBrush" Color="#0070DB"/>
      <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#005CB3"/>
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#260A84FF"/>
      <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0B0C"/>
      <SolidColorBrush x:Key="CanvasBrush" Color="#0B0B0C"/>
      <SolidColorBrush x:Key="CardBrush" Color="#1C1C1E"/>
      <SolidColorBrush x:Key="CardHoverBrush" Color="#3D767680"/>
      <SolidColorBrush x:Key="GlassBrush" Color="#1C1C1E"/>
      <SolidColorBrush x:Key="GlassStrongBrush" Color="#1C1C1E"/>
      <SolidColorBrush x:Key="GlassBorderBrush" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7"/>
      <SolidColorBrush x:Key="SecondaryTextBrush" Color="#98989D"/>
      <SolidColorBrush x:Key="TertiaryTextBrush" Color="#636366"/>
      <SolidColorBrush x:Key="DisabledTextBrush" Color="#98989D"/>
      <SolidColorBrush x:Key="DisabledBrush" Color="#2C2C2E"/>
      <SolidColorBrush x:Key="BorderBrush" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="SeparatorBrush" Color="#33FFFFFF"/>
      <SolidColorBrush x:Key="InputBorderBrush" Color="#3A3A3C"/>
      <SolidColorBrush x:Key="SubtleBrush" Color="#3D767680"/>
      <SolidColorBrush x:Key="SuccessBrush" Color="#30D158"/>
      <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2630D158"/>
      <SolidColorBrush x:Key="WarningBrush" Color="#FF9F0A"/>
      <SolidColorBrush x:Key="WarningSoftBrush" Color="#26FF9F0A"/>
      <SolidColorBrush x:Key="DangerBrush" Color="#FF453A"/>
      <SolidColorBrush x:Key="IconBrush" Color="#98989D"/>
      <SolidColorBrush x:Key="IconPlaceholderBrush" Color="#3A3A3C"/>
      <SolidColorBrush x:Key="OverlayBrush" Color="#66000000"/>
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#30D158"/>
      <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#30D158"/>
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#3ADB62"/>
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#3ADB62"/>
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#28B84B"/>
      <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#28B84B"/>
      <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#3A3A3C"/>
      <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#0A84FF"/>
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#0A84FF"/>
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="RadioButtonCheckGlyphStroke" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#0070DB"/>
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#0070DB"/>
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#005CB3"/>
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#005CB3"/>
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillDisabled" Color="#2C2C2E"/>
      <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokeDisabled" Color="#2C2C2E"/>
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokePointerOver" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokePressed" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="RadioButtonCheckGlyphFillDisabled" Color="#98989D"/>
      <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokeDisabled" Color="#98989D"/>
      <LinearGradientBrush x:Key="DeviceIconBrush" StartPoint="15%,0%" EndPoint="85%,100%">
        <GradientStop Color="#0096DC" Offset="0"/>
        <GradientStop Color="#3C46E6" Offset="1"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="HeroBlueBrush" StartPoint="15%,0%" EndPoint="85%,100%">
        <GradientStop Color="#0096DC" Offset="0"/>
        <GradientStop Color="#3C46E6" Offset="1"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="HeroTealBrush" StartPoint="15%,0%" EndPoint="85%,100%">
        <GradientStop Color="#30C4C8" Offset="0"/>
        <GradientStop Color="#007AFF" Offset="1"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="HeroIndigoBrush" StartPoint="15%,0%" EndPoint="85%,100%">
        <GradientStop Color="#786EFF" Offset="0"/>
        <GradientStop Color="#583CD6" Offset="1"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="HeroGreenBrush" StartPoint="15%,0%" EndPoint="85%,100%">
        <GradientStop Color="#48D678" Offset="0"/>
        <GradientStop Color="#14A06E" Offset="1"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="HeroOrangeBrush" StartPoint="15%,0%" EndPoint="85%,100%">
        <GradientStop Color="#FFB340" Offset="0"/>
        <GradientStop Color="#FF7028" Offset="1"/>
      </LinearGradientBrush>
      <RadialGradientBrush x:Key="BackgroundGlowBrush" Center="50%,0%" GradientOrigin="50%,0%" RadiusX="0.75" RadiusY="0.6">
        <GradientStop Color="#2E0A84FF" Offset="0"/>
        <GradientStop Color="#0D5C40E0" Offset="0.6"/>
        <GradientStop Color="#000A84FF" Offset="1"/>
      </RadialGradientBrush>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
