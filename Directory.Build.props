<Project>
  <PropertyGroup>
    <!-- CI overrides this from the release tag: dotnet publish -p:Version=1.2.3 -->
    <Version>1.7.2</Version>
    <Product>Перенос</Product>
    <Company>Perenos contributors</Company>
    <Authors>Perenos contributors</Authors>
    <Copyright>Copyright (c) 2026 Perenos contributors</Copyright>
    <RepositoryUrl>https://github.com/kr0nsch/perenos-ios</RepositoryUrl>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
