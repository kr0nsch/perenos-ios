<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Perenos.ViewModels"
             xmlns:s="using:Perenos.Services"
             xmlns:c="using:Perenos.Converters"
             x:Class="Perenos.Views.DeviceStepView" x:DataType="vm:MainViewModel">
  <UserControl.Resources>
    <c:InverseBoolConverter x:Key="Not"/>
    <c:EnumEqualsConverter x:Key="ToneIs"/>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="600" Margin="24,24,24,32" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid Width="112" Height="112" HorizontalAlignment="Center" Margin="0,0,0,10">
        <Border Classes="hero-tile blue" IsVisible="{Binding DeviceStepTone, Converter={StaticResource ToneIs}, ConverterParameter=Blue}">
          <PathIcon Width="34" Height="34" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm1 3v14h8V5H8Z"/>
        </Border>
        <Border Classes="hero-tile teal" IsVisible="{Binding DeviceStepTone, Converter={StaticResource ToneIs}, ConverterParameter=Teal}">
          <PathIcon Width="34" Height="34" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm1 3v14h8V5H8Z"/>
        </Border>
        <Border Classes="hero-tile indigo" IsVisible="{Binding DeviceStepTone, Converter={StaticResource ToneIs}, ConverterParameter=Indigo}">
          <PathIcon Width="34" Height="34" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm1 3v14h8V5H8Z"/>
        </Border>
      </Grid>
      <TextBlock Text="{Binding DeviceStepTitle}" Classes="h1" TextAlignment="Center" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding DeviceStepSubtitle}" Classes="body muted" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Margin="0,8,0,0"/>

      <Border Classes="card" Margin="0,28,0,0" Padding="16,14" IsVisible="{Binding Devices.IsServiceMissing}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
          <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource WarningBrush}" VerticalAlignment="Center">
            <PathIcon Width="17" Height="17" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M12 2 1 21h22L12 2Zm-1 7h2v6h-2V9Zm0 8h2v2h-2v-2Z"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding ServiceTitle}" Classes="title"/>
            <TextBlock Text="{Binding ServiceBody}" Classes="caption"/>
          </StackPanel>
          <Button Grid.Column="2" Content="{s:Text Service_Get}" VerticalAlignment="Center" IsVisible="{Binding ShowGetAppleDevices}" Click="GetAppleDevices"/>
        </Grid>
      </Border>

      <Border Classes="card" Margin="0,28,0,0" Padding="0,4">
        <Grid>
          <ItemsControl ItemsSource="{Binding Devices.Devices}" IsVisible="{Binding Devices.HasDevices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:DeviceItemViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" MinHeight="68" Margin="0,2">
                  <Button Grid.ColumnSpan="2" Classes="quiet" HorizontalContentAlignment="Stretch" Padding="12,10"
                          Command="{Binding $parent[ItemsControl].DataContext.ChooseDeviceCommand}" CommandParameter="{Binding}" IsEnabled="{Binding IsSelectable}" AutomationProperties.Name="{Binding Name}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                      <Border Classes="device-tile">
                        <PathIcon Width="19" Height="19" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm1 3v14h8V5H8Z"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <WrapPanel ItemSpacing="8" LineSpacing="4">
                          <TextBlock Text="{Binding Name}" Classes="title"/>
                          <Border Classes="soft" Padding="7,1" IsVisible="{Binding HasRole}">
                            <TextBlock Text="{Binding RoleText}" Classes="caption" FontSize="11"/>
                          </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Subtitle}" Classes="caption"/>
                        <TextBlock Text="{Binding StatusText}" Classes="caption" Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding ShowStatusIcon}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ProgressBar Width="36" Height="4" IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
                        <PathIcon Width="16" Height="16" Data="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17Z" Foreground="{DynamicResource AccentTextBrush}" IsVisible="{Binding IsChosen}"/>
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Grid.Column="2" Content="{s:Text Device_Retry}" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" VerticalAlignment="Center" Margin="8"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel IsVisible="{Binding Devices.IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,22,24,26" Spacing="10">
            <!-- Radar pulse around a phone while waiting for the first iPhone. -->
            <Grid Width="96" Height="96" HorizontalAlignment="Center">
              <Ellipse x:Name="PulseA" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="50%,50%">
                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse x:Name="PulseB" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="50%,50%">
                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
              </Ellipse>
              <Border Classes="device-tile" Width="40" Height="40" CornerRadius="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                <PathIcon Width="20" Height="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm1 3v14h8V5H8Z"/>
              </Border>
            </Grid>
            <TextBlock Text="{s:Text Devices_Searching}" Classes="body muted" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <Button Classes="link" Margin="0,14,0,0" HorizontalAlignment="Center">
        <TextBlock Text="{s:Text Devices_Help}"/>
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <StackPanel Width="380" Spacing="12">
              <TextBlock Text="{s:Text Help_Title}" Classes="title"/>
              <TextBlock Text="{s:Text Help_Cable}" Classes="caption"/>
              <TextBlock Text="{s:Text Help_Unlock}" Classes="caption"/>
              <TextBlock Text="{s:Text Help_Trust}" Classes="caption"/>
              <TextBlock Text="{Binding ServiceHelp}" Classes="caption"/>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </StackPanel>
  </ScrollViewer>
</UserControl>
