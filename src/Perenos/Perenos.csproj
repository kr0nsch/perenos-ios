<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Perenos</RootNamespace>
    <AssemblyName>Perenos</AssemblyName>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\Perenos.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**\*" />
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\catalog\LICENSE" Link="Licenses\RussianServiceCatalog.GPL-3.0.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\licenses\*" Link="Licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Perenos.Core\Perenos.Core.csproj" />
    <ProjectReference Include="..\Perenos.Presentation\Perenos.Presentation.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <Target Name="ExcludeDebugSymbols" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <IpatoolRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</IpatoolRid>
    <IpatoolRid Condition="'$(IpatoolRid)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</IpatoolRid>
    <IpatoolFileName Condition="$(IpatoolRid.StartsWith('win-'))">ipatool.exe</IpatoolFileName>
    <IpatoolFileName Condition="'$(IpatoolFileName)' == ''">ipatool</IpatoolFileName>
    <IpatoolPath Condition="'$(IpatoolPath)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\tools\$(IpatoolRid)\$(IpatoolFileName)</IpatoolPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(IpatoolPath)" Condition="Exists('$(IpatoolPath)')" Link="tools\$(IpatoolFileName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="WarnMissingIpatool" BeforeTargets="Build" Condition="!Exists('$(IpatoolPath)')">
    <Warning Text="ipatool not found at $(IpatoolPath). Run build/Get-Ipatool.ps1 -RuntimeIdentifier $(IpatoolRid) so the app can download apps." />
  </Target>

</Project>
