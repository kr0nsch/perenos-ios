<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Perenos.ViewModels"
        xmlns:s="using:Perenos.Services"
        x:Class="Perenos.Views.SettingsWindow" x:DataType="vm:MainViewModel"
        Width="600" Height="760" MinWidth="480" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Icon="avares://Perenos/Assets/Perenos.ico"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        WindowDecorations="BorderOnly"
        Title="{s:Text Settings_Title}">
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource BackgroundBrush}">
    <Rectangle Grid.RowSpan="3" IsHitTestVisible="False" Fill="{DynamicResource BackgroundGlowBrush}"/>
    <Grid x:Name="DialogTitleBar" Grid.Row="0" Height="44" Background="Transparent" PointerPressed="DragTitleBar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="{s:Text Settings_Title}" FontSize="13" FontWeight="SemiBold" Margin="14,0" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Classes="caption caption-close" Click="CloseWindow" AutomationProperties.Name="{s:Text Window_Close}">
          <PathIcon Width="12" Height="12" Data="m6.4 5 5.6 5.6L17.6 5 19 6.4 13.4 12 19 17.6 17.6 19 12 13.4 6.4 19 5 17.6 10.6 12 5 6.4 6.4 5Z"/>
        </Button>
      </Grid>
    </Grid>
    <ScrollViewer Grid.Row="1" Padding="28,8,28,20">
      <StackPanel MaxWidth="520" HorizontalAlignment="Center">
        <TextBlock Text="{s:Text Settings_General}" Classes="eyebrow" Margin="0,12,0,10"/>
        <Border Classes="card" Padding="18">
          <StackPanel Spacing="18">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
              <TextBlock Text="{s:Text Settings_Language}" Classes="body" VerticalAlignment="Center"/>
              <ComboBox x:Name="LanguageBox" Grid.Column="1" MinWidth="180" SelectionChanged="LanguageChanged" AutomationProperties.Name="{s:Text Settings_Language}"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
              <TextBlock Text="{s:Text Settings_Appearance}" Classes="body" VerticalAlignment="Center"/>
              <ComboBox x:Name="ThemeBox" Grid.Column="1" MinWidth="180" SelectionChanged="ThemeChanged" AutomationProperties.Name="{s:Text Settings_Appearance}"/>
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Text="{s:Text Settings_Downloads}" Classes="eyebrow" Margin="0,26,0,10"/>
        <Border Classes="card" Padding="18">
          <StackPanel Spacing="16">
            <StackPanel Spacing="5"><TextBlock Text="{s:Text Settings_Folder}" Classes="title"/><TextBlock Text="{Binding Services.DownloadDirectory}" Classes="caption"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{s:Text Settings_Open}" Click="OpenFolder"/>
              <Button Content="{s:Text Settings_Change}" Command="{Binding ChangeFolderCommand}"/>
            </StackPanel>
            <Border Classes="separator"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{s:Text Options_Keep}" Classes="body" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding Install.KeepDownloads}" AutomationProperties.Name="{s:Text Options_Keep}"/></Grid>
          </StackPanel>
        </Border>
        <TextBlock Text="{s:Text Settings_About}" Classes="eyebrow" Margin="0,26,0,10"/>
        <Border Classes="card" Padding="18">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{s:Text Settings_Version}" Classes="body"/><TextBlock Grid.Column="1" Text="{Binding Services.AppVersion}" Classes="body muted"/></Grid>
            <Border Classes="separator"/>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{s:Text Settings_Source}" Classes="body"/><Button Grid.Column="1" Classes="link" Content="GitHub" Click="OpenGitHub"/></Grid>
            <Border Classes="separator"/>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{s:Text Settings_Licenses}" Classes="body"/><Button Grid.Column="1" Classes="link" Content="{s:Text Settings_View}" Click="OpenLicenses"/></Grid>
            <Border Classes="separator"/>
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{s:Text Settings_Logs}" Classes="body"/><Button Grid.Column="1" Classes="link" Content="{s:Text Settings_OpenLogs}" Click="OpenLogs"/></Grid>
          </StackPanel>
        </Border>
        <TextBlock Text="{s:Text Settings_Disclaimer}" Classes="caption" Margin="0,18,0,0"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Padding="20">
      <Button Classes="secondary" Content="{s:Text Settings_Dialog.CloseButtonText}" HorizontalAlignment="Center" MinWidth="140" Click="CloseWindow"/>
    </Border>
  </Grid>
</Window>
